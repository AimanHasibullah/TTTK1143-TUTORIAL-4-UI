public class DataSet implements Measurable {
    private double sum;
    private Measurable max;
    private int count;
    private String name;

    public DataSet() {
        sum = 0;
        count = 0;
        max = null;
        name = "DataSet";
    }

    public void add(Measurable x) {
        sum += x.getMeasure();
        if (count == 0 || x.getMeasure() > max.getMeasure()) {
            max = x;
        }
        count++;
    }

    public Measurable getMax() {
        return max;
    }

    public double getAverage() {
        if (count == 0) return 0.0;
        return sum / count;
    }

    @Override
    public double getMeasure() {
        return getAverage();
    }

    @Override
    public String getName() {
        return name;
    }
}